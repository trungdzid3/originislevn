<?xml version="1.0" encoding="utf-8"?>
<!-- Vivo OriginOS 6 Adaptive Icon Background: Cosmic Space Blue with G2 Ambient Radial Dome Light -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Primary 135-degree Linear Gradient: Sapphire Blue (#2555FF / #1A36A0) to Deep Space Navy (#0A1538) -->
    <path
        android:pathData="M 0,0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#2555FF" android:offset="0.0" />
                <item android:color="#1A36A0" android:offset="0.45" />
                <item android:color="#0A1538" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. OriginOS 6 Soft Ambient Dome Light Glow (Top-Left Radial Accent) -->
    <path
        android:pathData="M 0,0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="26"
                android:centerY="22"
                android:gradientRadius="78">
                <item android:color="#59FFFFFF" android:offset="0.0" />
                <item android:color="#20FFFFFF" android:offset="0.42" />
                <item android:color="#00FFFFFF" android:offset="0.88" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Bottom-Right Cosmic Nebula Glow (Dynamic Neon Cyan / Emerald Accent) -->
    <path
        android:pathData="M 0,0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="84"
                android:centerY="86"
                android:gradientRadius="66">
                <item android:color="#3600E5FF" android:offset="0.0" />
                <item android:color="#1200D084" android:offset="0.50" />
                <item android:color="#000A1538" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
